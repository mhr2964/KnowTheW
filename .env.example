# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5051
NODE_ENV=development

# Third-party data/AI providers
BALLDONTLIE_KEY=          # BallDontLie API key (WNBA stats provider)
ANTHROPIC_API_KEY=        # Claude API key, powers the AI-generated narrative/report routes

# Data stores
MONGODB_URI=               # MongoDB connection string (Atlas or local), db name 'knowthew'

# Admin-gated ?refresh=1 endpoints (server/lib/adminAuth.js) — fail-closed if unset
ADMIN_TOKEN=

# Error reporting (optional — Sentry no-ops entirely if unset)
SENTRY_DSN=

# Username/password account system (server/lib/auth.js) — required for signup/login/requireAuth
# to function; fail-closed (401/500) if unset. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
